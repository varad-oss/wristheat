{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristheat/contracts/ingest_request.schema.json",
  "title": "WristHeat ingest request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trainee_id", "session_id", "source", "device", "samples"],
  "properties": {
    "schema": {"const": 1},
    "trainee_id": {"type": "string", "minLength": 1, "maxLength": 32},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{8,64}$"},
    "source": {"enum": ["live", "simulated", "replay"]},
    "device": {"type": "string", "maxLength": 40},
    "replay_of": {"type": ["string", "null"], "maxLength": 64},
    "samples": {
      "type": "array",
      "minItems": 0,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "bpm"],
        "properties": {
          "t": {"type": "integer", "minimum": 1700000000000},
          "bpm": {"type": "integer"}
        }
      }
    }
  }
}
